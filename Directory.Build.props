<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- cada camada nativa só roda no seu sistema, e o despacho é por OperatingSystem.IsX() em tempo de execução -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <Version>1.0.0</Version>
    <Company>LibertyX</Company>
    <Product>LibertyX Partition</Product>
    <Copyright>© 2026 Mauricio</Copyright>
  </PropertyGroup>
</Project>
