<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LibertyX.Partition.ViewModels" xmlns:c="using:LibertyX.Partition.Controls" xmlns:t="using:LibertyX.Partition.Core.Tools" x:Class="LibertyX.Partition.Views.SpaceView" x:DataType="vm:SpaceViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,14">
      <TextBlock Classes="h1" Text="Analisador de espaço" />
      <TextBlock Classes="muted" Text="Para onde foi o espaço: cada bloco é proporcional ao tamanho. Duplo clique entra na pasta." />
    </StackPanel>
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Roots}" Margin="0,0,0,6" MaxHeight="96" ClipToBounds="True">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String"><Button Content="{Binding}" Command="{Binding $parent[UserControl].((vm:SpaceViewModel)DataContext).UseRootCommand}" CommandParameter="{Binding}" Padding="10,7" Margin="0,0,6,6" /></DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,8,Auto,8,Auto" Margin="0,0,0,12">
      <TextBox Text="{Binding Path}" />
      <Button Grid.Column="2" Content="Escolher…" Command="{Binding BrowseCommand}" />
      <Panel Grid.Column="4">
        <Button Classes="primary" Command="{Binding AnalyzeCommand}" IsVisible="{Binding !Busy}" Padding="18,9">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcSpace}" Classes="small" /><TextBlock Text="Analisar" /></StackPanel>
        </Button>
        <Button Classes="danger" Content="Parar" Command="{Binding CancelCommand}" IsVisible="{Binding Busy}" />
      </Panel>
    </Grid>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Classes="faint" Margin="2,0,0,10" TextTrimming="CharacterEllipsis" />
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320" /><ColumnDefinition Width="20" /><ColumnDefinition Width="0.8*" MinWidth="270" MaxWidth="330" /></Grid.ColumnDefinitions>
      <Border Classes="glass" Padding="12">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
            <Button Classes="ghost" Command="{Binding UpCommand}" Padding="8,6"><PathIcon Data="{StaticResource IcChevronLeft}" Classes="small" /></Button>
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="t:SpaceNode">
                  <StackPanel Orientation="Horizontal">
                    <Button Classes="ghost" Content="{Binding Name}" Command="{Binding $parent[UserControl].((vm:SpaceViewModel)DataContext).CrumbCommand}" CommandParameter="{Binding}" Padding="6,4" />
                    <PathIcon Data="{StaticResource IcChevronRight}" Classes="small muted" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <Button Content="Abrir no Explorador" Command="{Binding RevealCommand}" />
              <Button Classes="danger" Content="Mandar para a Lixeira" Command="{Binding RecycleCommand}" />
            </StackPanel>
          </Grid>
          <c:TreemapView x:Name="Map" Items="{Binding Items}" Selected="{Binding Selected}" Version="{Binding Version}" />
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <Border Classes="card" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="4">
              <TextBlock Classes="section" Text="SELECIONADO" />
              <TextBlock Text="{Binding Selected.Name}" Classes="h3" TextWrapping="Wrap" />
              <TextBlock Classes="muted"><Run Text="{Binding Selected.Size, Converter={x:Static vm:Conv.Size}}" /><Run Text=" · " /><Run Text="{Binding Selected.Files, StringFormat='{}{0:N0} arquivo(s)'}" /></TextBlock>
              <TextBlock Text="{Binding Selected.FullPath}" Classes="faint" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Classes="section" Text="POR TIPO" Margin="0,0,0,4" />
              <ItemsControl ItemsSource="{Binding ByType}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:InfoRow">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,3"><TextBlock Text="{Binding Key}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Value}" Classes="faint" /></Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Classes="section" Text="MAIORES ARQUIVOS" Margin="0,0,0,4" />
              <ItemsControl ItemsSource="{Binding Largest}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:InfoRow">
                    <Grid ColumnDefinitions="74,*" Margin="0,3"><TextBlock Text="{Binding Key}" FontWeight="Bold" Foreground="{StaticResource Ouro}" /><TextBlock Grid.Column="1" Text="{Binding Value}" Classes="faint" TextTrimming="LeadingCharacterEllipsis" /></Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
