<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:LibertyX.Partition" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LibertyX.Partition.ViewModels" xmlns:c="using:LibertyX.Partition.Controls" x:Class="LibertyX.Partition.Views.BackupView" x:DataType="vm:BackupViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,10">
      <TextBlock Classes="h1" Text="{l:T 'Backup e imagem'}" />
      <TextBlock Classes="muted" Text="{l:T 'Disco com defeito? A primeira coisa é tirar uma imagem dele — e recuperar da imagem, não do disco.'}" />
    </StackPanel>
    <TabControl SelectedIndex="{Binding Tab}" Padding="0,14,0,0">
      <TabItem Header="{l:T 'Criar imagem'}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320" /><ColumnDefinition Width="20" /><ColumnDefinition Width="0.8*" MinWidth="270" MaxWidth="400" /></Grid.ColumnDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10"><TextBlock Classes="section" Text="{l:T 'O QUE COPIAR'}" /><ContentControl Content="{Binding ImageSource}" /></StackPanel>
          </ScrollViewer>
          <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
            <StackPanel Spacing="12">
              <TextBlock Classes="section" Text="{l:T 'DESTINO'}" />
              <Grid ColumnDefinitions="*,8,Auto">
                <TextBox Text="{Binding ImagePath}" Watermark="{l:T 'Arquivo .img em outro disco'}" />
                <Button Grid.Column="2" Content="{l:T 'Escolher…'}" Command="{Binding PickImagePathCommand}" />
              </Grid>
              <CheckBox IsChecked="{Binding Hash}" Content="{l:T 'Calcular SHA-256 (prova de integridade)'}" />
              <CheckBox IsChecked="{Binding UseVss}" Content="{x:Static vm:Ui.SnapshotImage}" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{l:T 'Novas tentativas por setor ruim'}" VerticalAlignment="Center" FontSize="13" />
                <NumericUpDown Value="{Binding Retries}" Minimum="0" Maximum="10" Width="110" FormatString="0" />
              </StackPanel>
              <Border Classes="notice gold">
                <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Text="{l:T 'Cópia setor a setor no estilo ddrescue: blocos grandes enquanto o disco responde; ao primeiro erro, desce para setor a setor naquele trecho, anota os ilegíveis e segue. A imagem é .img crua — abre em qualquer ferramenta forense e aqui mesmo, em Abrir imagem.'}" />
              </Border>
              <Button Classes="primary" Command="{Binding CreateImageCommand}" IsEnabled="{Binding CanImage}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16,12">
                <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcBackup}" /><TextBlock Text="{l:T 'Criar imagem'}" /></StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="{l:T 'Restaurar imagem'}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320" /><ColumnDefinition Width="20" /><ColumnDefinition Width="0.8*" MinWidth="270" MaxWidth="400" /></Grid.ColumnDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10"><TextBlock Classes="section" Text="{l:T 'DESTINO (SERÁ SOBRESCRITO)'}" /><ContentControl Content="{Binding RestoreTarget}" /></StackPanel>
          </ScrollViewer>
          <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
            <StackPanel Spacing="12">
              <TextBlock Classes="section" Text="{l:T 'IMAGEM'}" />
              <Grid ColumnDefinitions="*,8,Auto">
                <TextBox Text="{Binding RestoreFile}" Watermark="{l:T 'Arquivo .img'}" IsReadOnly="True" />
                <Button Grid.Column="2" Content="{l:T 'Escolher…'}" Command="{Binding PickRestoreFileCommand}" />
              </Grid>
              <TextBlock Text="{Binding RestoreInfo}" Classes="faint" TextWrapping="Wrap" />
              <Button Classes="danger" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16,12">
                <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcRestore}" /><TextBlock Text="{l:T 'Restaurar'}" /></StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="{l:T 'Backup de pastas'}">
        <Border Classes="card" VerticalAlignment="Top" MaxWidth="760" HorizontalAlignment="Left">
          <StackPanel Spacing="12">
            <TextBlock Classes="section" Text="{l:T 'PASTAS'}" />
            <ItemsControl ItemsSource="{Binding Folders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                    <PathIcon Data="{StaticResource IcFolder}" Classes="small gold" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="ghost" Content="{l:T 'Remover'}" Command="{Binding $parent[UserControl].((vm:BackupViewModel)DataContext).RemoveFolderCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{l:T 'Adicionar pasta…'}" Command="{Binding AddFolderCommand}" HorizontalAlignment="Left" />
            <TextBlock Classes="section" Text="{l:T 'ARQUIVO DE BACKUP'}" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="*,8,Auto">
              <TextBox Text="{Binding ZipPath}" Watermark="{l:T 'Backup.zip'}" />
              <Button Grid.Column="2" Content="{l:T 'Escolher…'}" Command="{Binding PickZipCommand}" />
            </Grid>
            <Button Classes="primary" Command="{Binding ZipCommand}" IsEnabled="{Binding CanZip}" HorizontalAlignment="Right" Padding="18,11">
              <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcArchive}" /><TextBlock Text="{l:T 'Fazer backup'}" /></StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
