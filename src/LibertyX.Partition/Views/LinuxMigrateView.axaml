<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:LibertyX.Partition" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LibertyX.Partition.ViewModels" x:Class="LibertyX.Partition.Views.LinuxMigrateView" x:DataType="vm:LinuxMigrateViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,18">
      <TextBlock Classes="h1" Text="{Binding Title}" />
      <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
    </StackPanel>
    <Grid ColumnDefinitions="*,24,1.15*">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10"><TextBlock Classes="section" Text="{l:T 'DISCO NOVO (SERÁ APAGADO)'}" /><ContentControl Content="{Binding Target}" /></StackPanel>
      </ScrollViewer>
      <Border Grid.Column="2" Classes="glass" Padding="20,16" VerticalAlignment="Top">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="{l:T 'O QUE VAI PARA O DISCO NOVO'}" />
          <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Pieces}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MigratePieceRow">
                <Border Classes="inset" Padding="12,9" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <CheckBox IsChecked="{Binding Include}" IsEnabled="{Binding Optional}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip.Tip="{l:T 'Partições do sistema vão sempre; as de dados podem ficar no disco antigo.'}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Detail}" Classes="faint" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding TargetText}" VerticalAlignment="Center" Margin="10,0,0,0" Classes="goldtext" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Notes}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Apagado}" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="notice danger" IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" />
          </Border>
          <Button Classes="primary" Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcPlay}" /><TextBlock Text="{l:T 'Começar'}" /></StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
