<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LibertyX.Partition.ViewModels" xmlns:c="using:LibertyX.Partition.Controls" xmlns:t="using:LibertyX.Partition.Core.Tools" x:Class="LibertyX.Partition.Views.BootMediaView" x:DataType="vm:BootMediaViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,18">
      <TextBlock Classes="h1" Text="Mídia inicializável" />
      <TextBlock Classes="muted" Text="Pendrive de instalação do Windows ou de qualquer ISO inicializável (Linux, ferramentas de resgate)." />
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320" /><ColumnDefinition Width="20" /><ColumnDefinition Width="0.8*" MinWidth="270" MaxWidth="420" /></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10"><TextBlock Classes="section" Text="PENDRIVE (SERÁ APAGADO)" /><ContentControl Content="{Binding Target}" /></StackPanel>
      </ScrollViewer>
      <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="IMAGEM" />
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox Text="{Binding Iso}" Watermark="Arquivo .iso" IsReadOnly="True" />
            <Button Grid.Column="2" Content="Escolher…" Command="{Binding PickIsoCommand}" />
          </Grid>
          <TextBlock Text="{Binding IsoInfo}" Classes="faint" TextWrapping="Wrap" />
          <TextBlock Classes="section" Text="MODO" Margin="0,6,0,0" />
          <ComboBox ItemsSource="{Binding Modes}" SelectedIndex="{Binding Mode}" HorizontalAlignment="Stretch" />
          <StackPanel Spacing="6">
            <TextBlock Text="Rótulo do pendrive (modo Windows)" FontSize="12.5" Foreground="{StaticResource Apagado}" />
            <TextBox Text="{Binding Label}" MaxLength="11" />
          </StackPanel>
          <Border Classes="notice gold">
            <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Text="Modo Windows: FAT32 que inicia tanto em UEFI quanto em BIOS; se o install.wim passar de 4 GB, ele é dividido em partes .swm pelo DISM — a instalação lê normalmente." />
          </Border>
          <Button Classes="primary" Command="{Binding WriteCommand}" IsEnabled="{Binding CanWrite}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcBoot}" /><TextBlock Text="Criar pendrive" /></StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
