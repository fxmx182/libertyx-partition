<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LibertyX.Partition.ViewModels" xmlns:c="using:LibertyX.Partition.Controls" xmlns:t="using:LibertyX.Partition.Core.Tools" x:Class="LibertyX.Partition.Views.BenchmarkView" x:DataType="vm:BenchmarkViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16">
      <StackPanel Margin="0,4,0,2">
        <TextBlock Classes="h1" Text="Benchmark de disco" />
        <TextBlock Classes="muted" Text="Velocidade real, sem o cache do Windows: arquivo de dados aleatórios e várias requisições em voo, como fazem os SSDs no dia a dia." />
      </StackPanel>
      <Border Classes="card">
        <StackPanel Spacing="16">
          <WrapPanel>
            <ComboBox ItemsSource="{Binding Drives}" SelectedIndex="{Binding DriveIndex}" MinWidth="240" Margin="0,0,12,8" />
            <ComboBox ItemsSource="{Binding Sizes}" SelectedIndex="{Binding SizeIndex}" Width="130" Margin="0,0,12,8" />
            <ComboBox ItemsSource="{Binding Durations}" SelectedIndex="{Binding DurationIndex}" Width="150" Margin="0,0,12,8" />
            <CheckBox IsChecked="{Binding IncludeWrite}" Content="Incluir escrita" Margin="0,0,12,8" />
            <Panel Margin="0,0,0,8">
              <Button Classes="primary" Command="{Binding RunCommand}" IsVisible="{Binding !Running}" Padding="20,10">
                <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcPlay}" /><TextBlock Text="Medir" /></StackPanel>
              </Button>
              <Button Classes="danger" Content="Parar" Command="{Binding StopCommand}" IsVisible="{Binding Running}" Padding="20,10" />
            </Panel>
          </WrapPanel>
          <Grid ColumnDefinitions="*,Auto">
            <ProgressBar Value="{Binding Fraction}" Maximum="1" />
            <TextBlock Grid.Column="1" Text="{Binding Phase}" Classes="faint" Margin="12,0,0,0" />
          </Grid>
          <Grid ColumnDefinitions="0.9*,*,*">
            <TextBlock Grid.Column="1" Classes="section" Text="LEITURA · MB/S" Margin="10,0,0,0" />
            <TextBlock Grid.Column="2" Classes="section" Text="ESCRITA · MB/S" Margin="10,0,0,0" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BenchRow">
                <Grid ColumnDefinitions="0.9*,*,*" Margin="0,0,0,10">
                  <TextBlock Text="{Binding Label}" FontWeight="Bold" VerticalAlignment="Center" FontSize="14" />
                  <Border Grid.Column="1" Classes="inset" Padding="14,10" Margin="0,0,10,0">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Read}" Classes="h1" Foreground="{StaticResource Ouro}" />
                        <TextBlock Grid.Column="1" Text="{Binding ReadDetail}" Classes="faint" VerticalAlignment="Bottom" />
                      </Grid>
                      <ProgressBar Value="{Binding ReadBar}" Maximum="1" MinHeight="5" Height="5" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Classes="inset" Padding="14,10">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Write}" Classes="h1" Foreground="{StaticResource Verde}" />
                        <TextBlock Grid.Column="1" Text="{Binding WriteDetail}" Classes="faint" VerticalAlignment="Bottom" />
                      </Grid>
                      <ProgressBar Value="{Binding WriteBar}" Maximum="1" MinHeight="5" Height="5" Foreground="{StaticResource Verde}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="CURVA DE LEITURA AO LONGO DO DISCO (SÓ LEITURA, DIRETO NO DISPOSITIVO)" />
          <Grid ColumnDefinitions="*,12,Auto">
            <ComboBox ItemsSource="{Binding Disks}" SelectedIndex="{Binding DiskIndex}" HorizontalAlignment="Stretch" />
            <Button Grid.Column="2" Content="Traçar curva" Command="{Binding RunCurveCommand}" IsEnabled="{Binding !Running}" />
          </Grid>
          <Border Classes="inset" Height="200" Padding="10">
            <c:LineChart Values="{Binding Curve}" Version="{Binding CurveVersion}" />
          </Border>
          <TextBlock Text="{Binding CurveText}" Classes="faint" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
