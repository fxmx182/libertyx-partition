<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LibertyX.Partition.ViewModels" xmlns:c="using:LibertyX.Partition.Controls" x:Class="LibertyX.Partition.Views.CopyPartitionView" x:DataType="vm:CopyPartitionViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,18">
      <TextBlock Classes="h1" Text="Copiar partição" />
      <TextBlock Classes="muted" Text="Duplica uma partição num espaço livre deste ou de outro disco. Partição em uso é copiada por instantâneo VSS." />
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Classes="glass" Padding="18,12" Margin="0,14,0,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <CheckBox IsChecked="{Binding UsedOnly}" Content="Só o espaço em uso (mais rápido)" Margin="0,0,20,0" ToolTip.Tip="Arquivos apagados não são copiados nesse modo." />
        <CheckBox Grid.Column="1" IsChecked="{Binding UseVss}" Content="{x:Static vm:Ui.SnapshotPartition}" />
        <TextBlock Grid.Column="2" Text="{Binding Problem}" Foreground="{StaticResource Laranja}" VerticalAlignment="Center" Margin="16,0" TextWrapping="Wrap" />
        <Button Grid.Column="3" Classes="primary" Command="{Binding CopyCommand}" IsEnabled="{Binding CanCopy}" Padding="20,11">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcCopyPartition}" /><TextBlock Text="Copiar" /></StackPanel>
        </Button>
      </Grid>
    </Border>
    <Grid ColumnDefinitions="*,24,*">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10"><TextBlock Classes="section" Text="1 · PARTIÇÃO DE ORIGEM" /><ContentControl Content="{Binding Source}" /></StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10"><TextBlock Classes="section" Text="2 · ESPAÇO LIVRE DE DESTINO" /><ContentControl Content="{Binding Target}" /></StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
