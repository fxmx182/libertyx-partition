<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LibertyX.Partition.ViewModels" xmlns:c="using:LibertyX.Partition.Controls" xmlns:core="using:LibertyX.Partition.Core.Platform" x:Class="LibertyX.Partition.Views.ConvertView" x:DataType="vm:ConvertViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,18">
      <TextBlock Classes="h1" Text="Converter GPT ⇄ MBR" />
      <TextBlock Classes="muted" Text="Troca o estilo da tabela sem apagar as partições: só a tabela é reescrita." />
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320" /><ColumnDefinition Width="20" /><ColumnDefinition Width="0.8*" MinWidth="270" MaxWidth="400" /></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10"><TextBlock Classes="section" Text="DISCO" /><ContentControl Content="{Binding Picker}" /></StackPanel>
      </ScrollViewer>
      <Border Grid.Column="2" Classes="card" VerticalAlignment="Top" IsVisible="{Binding HasDisk}">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto,*">
            <Border Classes="inset" Padding="10,16"><TextBlock Text="{Binding From}" Classes="h1" HorizontalAlignment="Center" /></Border>
            <PathIcon Grid.Column="1" Data="{StaticResource IcChevronRight}" Classes="large gold" Margin="10,0" />
            <Border Grid.Column="2" Classes="inset" Padding="10,16" BorderBrush="#66FBC501"><TextBlock Text="{Binding To}" Classes="h1" HorizontalAlignment="Center" Foreground="{StaticResource Ouro}" /></Border>
          </Grid>
          <ItemsControl ItemsSource="{Binding Notes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                  <PathIcon Data="{StaticResource IcInfo}" Classes="small muted" VerticalAlignment="Top" Margin="0,2,10,0" />
                  <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="13" LineHeight="19" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="primary" Command="{Binding ConvertCommand}" IsEnabled="{Binding Ok}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16,12">
            <TextBlock><Run Text="Converter para " /><Run Text="{Binding To}" /></TextBlock>
          </Button>
          <Button Command="{Binding Mbr2GptCommand}" IsVisible="{Binding OfferMbr2Gpt}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
            <TextBlock Text="Converter o disco do Windows com MBR2GPT (oficial)" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
