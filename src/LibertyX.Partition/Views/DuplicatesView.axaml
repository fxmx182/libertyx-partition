<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LibertyX.Partition.ViewModels" xmlns:c="using:LibertyX.Partition.Controls" xmlns:t="using:LibertyX.Partition.Core.Tools" x:Class="LibertyX.Partition.Views.DuplicatesView" x:DataType="vm:DuplicatesViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,14">
      <TextBlock Classes="h1" Text="Limpador de duplicados" />
      <TextBlock Classes="muted" Text="Arquivos idênticos byte a byte (não “mesmo nome”): compara tamanho, depois uma impressão rápida, depois o conteúdo inteiro." />
    </StackPanel>
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12" Padding="16,14">
      <Grid ColumnDefinitions="*,16,Auto">
        <StackPanel Spacing="8">
          <ItemsControl ItemsSource="{Binding Folders}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Border Classes="chip gold" Margin="0,0,6,6" Padding="10,4">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding}" />
                    <Button Classes="ghost" Padding="2" Command="{Binding $parent[UserControl].((vm:DuplicatesViewModel)DataContext).RemoveFolderCommand}" CommandParameter="{Binding}"><PathIcon Data="{StaticResource IcClose}" Width="11" Height="11" /></Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel>
            <Button Content="Adicionar pasta…" Command="{Binding AddFolderCommand}" Margin="0,0,10,6" />
            <ComboBox ItemsSource="{Binding MinSizes}" SelectedIndex="{Binding MinIndex}" Width="170" Margin="0,0,10,6" />
            <ComboBox ItemsSource="{Binding Kinds}" SelectedIndex="{Binding KindIndex}" Width="160" Margin="0,0,10,6" />
          </WrapPanel>
        </StackPanel>
        <Panel Grid.Column="2" VerticalAlignment="Center">
          <Button Classes="primary" Command="{Binding FindCommand}" IsVisible="{Binding !Busy}" Padding="20,11">
            <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcSearch}" /><TextBlock Text="Procurar duplicados" /></StackPanel>
          </Button>
          <Button Classes="danger" Content="Parar" Command="{Binding CancelCommand}" IsVisible="{Binding Busy}" />
        </Panel>
      </Grid>
    </Border>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Classes="faint" Margin="2,0,0,10" />
    <Border DockPanel.Dock="Bottom" Classes="glass" Padding="18,12" Margin="0,12,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <ComboBox ItemsSource="{Binding Rules}" SelectedIndex="{Binding RuleIndex}" Width="260" />
        <TextBlock Grid.Column="1" Text="{Binding Selection}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0" />
        <Button Grid.Column="2" Classes="primary" Command="{Binding RemoveCommand}" IsEnabled="{Binding HasSelection}" Padding="18,11">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcTrash}" /><TextBlock Text="Mover marcados para a Lixeira" /></StackPanel>
        </Button>
      </Grid>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DupGroupRow">
            <Border Classes="card" Padding="14,12" Margin="0,0,0,10">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Header}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="1" Classes="chip orange"><TextBlock Text="{Binding Waste}" /></Border>
                </Grid>
                <ItemsControl ItemsSource="{Binding Files}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DupFileRow">
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                        <CheckBox IsChecked="{Binding IsChecked}" />
                        <TextBlock Grid.Column="1" Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="LeadingCharacterEllipsis" FontSize="12.5" />
                        <TextBlock Grid.Column="2" Text="{Binding Date}" Classes="faint" VerticalAlignment="Center" Margin="12,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
