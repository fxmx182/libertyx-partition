<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LibertyX.Partition.ViewModels" xmlns:c="using:LibertyX.Partition.Controls" xmlns:core="using:LibertyX.Partition.Core.Platform" x:Class="LibertyX.Partition.Views.SurfaceView" x:DataType="vm:SurfaceViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,18">
      <TextBlock Classes="h1" Text="Teste de superfície" />
      <TextBlock Classes="muted" Text="Lê cada bloco do disco e cronometra. Bloco que não lê é setor ruim; bloco lento é setor fraco — o aviso que vem antes da falha." />
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*" MinWidth="250" MaxWidth="360" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" MinWidth="320" /></Grid.ColumnDefinitions>
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
          <Button Classes="primary" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="9"><PathIcon Data="{StaticResource IcPlay}" /><TextBlock Text="Iniciar teste (só leitura)" /></StackPanel>
          </Button>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <TextBlock Classes="section" Text="O QUE TESTAR" />
            <ContentControl Content="{Binding Picker}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
      <Border Grid.Column="2" Classes="card">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="{Binding TargetText}" Classes="h3" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Elapsed}" Classes="faint" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding Running}">
              <Button Command="{Binding TogglePauseCommand}">
                <Panel><TextBlock Text="Pausar" IsVisible="{Binding !Paused}" /><TextBlock Text="Continuar" IsVisible="{Binding Paused}" /></Panel>
              </Button>
              <Button Classes="danger" Content="Parar" Command="{Binding StopCommand}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Salvar relatório" Command="{Binding SaveReportCommand}" IsVisible="{Binding CanSaveReport}" />
          </Grid>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel MinWidth="112" Margin="0,0,22,8"><TextBlock Classes="section" Text="LIDO" /><TextBlock Text="{Binding Fraction, StringFormat='{}{0:P0}'}" Classes="h2" /></StackPanel>
            <StackPanel MinWidth="112" Margin="0,0,22,8"><TextBlock Classes="section" Text="VELOCIDADE" /><TextBlock Text="{Binding Speed}" Classes="h2" /></StackPanel>
            <StackPanel MinWidth="112" Margin="0,0,22,8"><TextBlock Classes="section" Text="BONS" /><TextBlock Text="{Binding Good}" Classes="h2" Foreground="{StaticResource Verde}" /></StackPanel>
            <StackPanel MinWidth="112" Margin="0,0,22,8"><TextBlock Classes="section" Text="LENTOS" /><TextBlock Classes="h2" Foreground="{StaticResource Laranja}"><Run Text="{Binding Slow}" /><Run Text=" + " Foreground="{StaticResource Tenue}" /><Run Text="{Binding VerySlow}" /></TextBlock></StackPanel>
            <StackPanel MinWidth="112" Margin="0,0,22,8"><TextBlock Classes="section" Text="ILEGÍVEIS" /><TextBlock Text="{Binding Bad}" Classes="h2" Foreground="{StaticResource Vermelho}" /></StackPanel>
          </WrapPanel>
          <ProgressBar DockPanel.Dock="Top" Value="{Binding Fraction}" Maximum="1" Margin="0,0,0,16" />
          <Border DockPanel.Dock="Bottom" Classes="notice gold" Margin="0,14,0,0" IsVisible="{Binding Verdict, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap" />
          </Border>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="16" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="12" CornerRadius="3" Background="#C835D0BE" /><TextBlock Text="bom" Classes="faint" /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="12" CornerRadius="3" Background="#FBC501" /><TextBlock Text="lento (&gt;150 ms/MB)" Classes="faint" /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="12" CornerRadius="3" Background="#FFA24D" /><TextBlock Text="muito lento (&gt;500 ms/MB)" Classes="faint" /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="12" CornerRadius="3" Background="#FF5A5A" /><TextBlock Text="ilegível" Classes="faint" /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="12" CornerRadius="3" Background="#14FFFFFF" /><TextBlock Text="não lido" Classes="faint" /></StackPanel>
          </StackPanel>
          <c:SectorMap Cells="{Binding Cells}" Version="{Binding Version}" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
