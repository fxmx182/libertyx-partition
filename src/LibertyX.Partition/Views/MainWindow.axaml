<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LibertyX.Partition.ViewModels"
        xmlns:c="using:LibertyX.Partition.Controls"
        x:Class="LibertyX.Partition.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="LibertyX Partition"
        Width="1440" Height="900" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="#0C0B0A"
        Foreground="{StaticResource Texto}"
        FontFamily="{StaticResource Manrope}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">
  <Window.Styles>
    <!-- janela estreita: a barra lateral vira só ícones (o nome aparece ao passar o mouse) -->
    <Style Selector="Grid#Shell :is(Control).slim"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Grid#Shell.compact :is(Control).slim"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="Grid#Shell.compact :is(Control).wide"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Grid#Shell Button.nav"><Setter Property="ToolTip.ServiceEnabled" Value="False" /></Style>
    <Style Selector="Grid#Shell.compact Button.nav">
      <Setter Property="ToolTip.ServiceEnabled" Value="True" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0,9" />
    </Style>
    <Style Selector="Grid#Shell.compact DockPanel.side"><Setter Property="Margin" Value="8,18,8,12" /></Style>
    <Style Selector="Grid#Shell.compact StackPanel.brand"><Setter Property="Margin" Value="10,10,0,18" /></Style>
    <Style Selector="Grid#Shell.compact StackPanel.navgroup"><Setter Property="Margin" Value="0,0,0,10" /></Style>
  </Window.Styles>
  <Panel>
    <!-- a luz de cima: ouro fraco no alto à esquerda, violeta frio no rodapé -->
    <Border IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="10%,-6%" GradientOrigin="10%,-6%" RadiusX="95%" RadiusY="95%">
          <GradientStop Offset="0" Color="#26FBC501" />
          <GradientStop Offset="1" Color="#00FBC501" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="100%,105%" GradientOrigin="100%,105%" RadiusX="80%" RadiusY="80%">
          <GradientStop Offset="0" Color="#283A2E6E" />
          <GradientStop Offset="1" Color="#003A2E6E" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>

    <Grid x:Name="Shell" ColumnDefinitions="256,*">
      <!-- barra lateral -->
      <Border Background="#59000000" BorderBrush="#10FFFFFF" BorderThickness="0,0,1,0">
        <DockPanel Classes="side" Margin="14,18,14,14">
          <StackPanel DockPanel.Dock="Top" Classes="brand" Orientation="Horizontal" Spacing="12" Margin="8,10,0,18">
            <Path Data="{StaticResource LogoMark}" Fill="{StaticResource OuroGradiente}" Width="40" Height="40" Stretch="Uniform" />
            <StackPanel VerticalAlignment="Center" Classes="wide">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="LIBERTYX" FontSize="10.5" FontWeight="Bold" LetterSpacing="2.6" Foreground="{StaticResource Ouro}" VerticalAlignment="Center" />
                <Border CornerRadius="999" Padding="6,1" VerticalAlignment="Center" Background="#14FFFFFF" Classes.premiumchip="{Binding IsPremium}">
                  <TextBlock Text="{Binding EditionText}" FontSize="8.5" FontWeight="Bold" LetterSpacing="1.2" Foreground="{StaticResource Apagado}" />
                </Border>
              </StackPanel>
              <TextBlock Text="Partition" FontSize="21" FontWeight="ExtraBold" LetterSpacing="-0.6" Margin="0,-4,0,0" />
            </StackPanel>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
            <!-- versão nova publicada: um clique baixa e atualiza por cima -->
            <Panel Classes="slim">
              <Button Classes="primary" Command="{Binding UpdateNowCommand}" IsVisible="{Binding UpdateAvailable}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,9" ToolTip.Tip="{Binding UpdateText}">
                <PathIcon Data="{StaticResource IcDownload}" Width="15" Height="15" />
              </Button>
            </Panel>
            <Panel Classes="wide">
            <Border Classes="notice gold" Padding="12,10" IsVisible="{Binding UpdateAvailable}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding UpdateText}" FontSize="12.5" FontWeight="Bold" />
                  <TextBlock Text="Correções e novidades" FontSize="11" Foreground="{StaticResource Tenue}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="primary" Command="{Binding UpdateNowCommand}" Padding="12,7" FontSize="12.5">
                  <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IcDownload}" Width="12" Height="12" /><TextBlock Text="Atualizar" /></StackPanel>
                </Button>
              </Grid>
            </Border>
            </Panel>
            <!-- a fila, versão estreita: quantas alterações esperam, e os dois botões -->
            <Border Classes="inset pendingbox slim" Classes.active="{Binding HasPending}" Padding="6,8" ToolTip.Tip="{Binding PendingTitle}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Pending.Count}" HorizontalAlignment="Center" FontWeight="ExtraBold" FontSize="15" Classes.goldtext="{Binding HasPending}" />
                <Button Classes="primary" Command="{Binding ApplyPendingCommand}" IsEnabled="{Binding HasPending}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,8" ToolTip.Tip="Confirmar">
                  <PathIcon Data="{StaticResource IcCheck}" Width="14" Height="14" />
                </Button>
                <Button Command="{Binding DiscardPendingCommand}" IsEnabled="{Binding HasPending}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,8" ToolTip.Tip="Cancelar">
                  <PathIcon Data="{StaticResource IcClose}" Width="12" Height="12" />
                </Button>
              </StackPanel>
            </Border>
            <!-- a fila: nada vai para o disco antes do Confirmar -->
            <Border Classes="inset pendingbox wide" Classes.active="{Binding HasPending}" Padding="10,10,10,10">
              <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="{Binding PendingTitle}" Classes.goldtext="{Binding HasPending}" Margin="2,0,0,0" />
                <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasPending}">
                  <ItemsControl ItemsSource="{Binding Pending}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PendingOp">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                          <PathIcon Data="{Binding Icon}" Width="14" Height="14" VerticalAlignment="Top" Margin="2,2,8,0" Classes="tree" Classes.del="{Binding Dangerous}" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Tenue}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Button Grid.Column="2" Classes="ghost" Padding="4" VerticalAlignment="Top" Command="{Binding Remove}" ToolTip.Tip="Tirar da fila">
                            <PathIcon Data="{StaticResource IcClose}" Width="11" Height="11" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="O que você alterar espera aqui até ser confirmado. Nada é gravado antes disso." FontSize="11" Foreground="{StaticResource Tenue}" TextWrapping="Wrap" IsVisible="{Binding !HasPending}" Margin="2,0" />
                <Grid ColumnDefinitions="*,8,*">
                  <Button Content="Cancelar" Command="{Binding DiscardPendingCommand}" IsEnabled="{Binding HasPending}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,9" />
                  <Button Grid.Column="2" Classes="primary" Command="{Binding ApplyPendingCommand}" IsEnabled="{Binding HasPending}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,9">
                    <StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Data="{StaticResource IcCheck}" Width="13" Height="13" /><TextBlock Text="Confirmar" FontSize="13" /></StackPanel>
                  </Button>
                </Grid>
              </StackPanel>
            </Border>
            <!-- Linux sem root: o pkexec pede a senha numa janela do sistema e o app reabre com acesso aos discos -->
            <Panel Classes="wide">
            <Border Classes="notice warn" Padding="12,10" IsVisible="{Binding CanElevate}">
              <StackPanel Spacing="8">
                <TextBlock Text="Sem acesso aos discos" FontSize="12.5" FontWeight="Bold" />
                <TextBlock Text="Para ler e alterar discos, o LibertyX precisa de permissão de administrador. Imagens anexadas funcionam sem ela." FontSize="11" Foreground="{StaticResource Tenue}" TextWrapping="Wrap" />
                <Button Classes="primary" Command="{Binding ElevateCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,8">
                  <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IcShield}" Width="13" Height="13" /><TextBlock Text="Entrar como administrador" FontSize="12.5" /></StackPanel>
                </Button>
              </StackPanel>
            </Border>
            </Panel>
            <Panel Classes="slim">
              <Button Classes="primary" Command="{Binding ElevateCommand}" IsVisible="{Binding CanElevate}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,9" ToolTip.Tip="Entrar como administrador">
                <PathIcon Data="{StaticResource IcShield}" Width="15" Height="15" />
              </Button>
            </Panel>
            <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="7" Margin="6,0,0,0">
              <PathIcon Data="{StaticResource IcShield}" Classes="small" Foreground="{StaticResource Verde}" IsVisible="{Binding IsAdmin}" />
              <PathIcon Data="{StaticResource IcAlert}" Classes="small" Foreground="{StaticResource Laranja}" IsVisible="{Binding !IsAdmin}" />
              <TextBlock Classes="wide" FontSize="11" Foreground="{StaticResource Tenue}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="{Binding StatusMaxWidth}">
                <Run Text="{Binding AdminText}" /><Run Text=" · " /><Run Text="{Binding Version}" />
              </TextBlock>
            </StackPanel>
            <!-- Linux: tamanho da interface (monitor 4K); o app reabre no tamanho escolhido -->
            <Button Grid.Column="1" IsVisible="{Binding IsLinux}" Padding="6,2" MinHeight="0" Background="Transparent" BorderThickness="0"
                    ToolTip.Tip="Tamanho da interface" VerticalAlignment="Center">
              <TextBlock Text="Aa" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Tenue}" />
              <Button.Flyout>
                <MenuFlyout ItemsSource="{Binding ScaleItems}" Placement="TopEdgeAlignedLeft">
                  <MenuFlyout.ItemContainerTheme>
                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:ScaleItem">
                      <Setter Property="Header" Value="{Binding Header}" />
                      <Setter Property="ToggleType" Value="Radio" />
                      <Setter Property="IsChecked" Value="{Binding Checked}" />
                      <Setter Property="Command" Value="{Binding Choose}" />
                      <Setter Property="CommandParameter" Value="{Binding Value}" />
                    </ControlTheme>
                  </MenuFlyout.ItemContainerTheme>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            </Grid>
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Nav}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NavGroup">
                  <StackPanel Classes="navgroup" Margin="0,0,0,16">
                    <TextBlock Classes="section wide" Text="{Binding Title}" Margin="12,0,0,6" TextTrimming="CharacterEllipsis" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                          <Panel>
                            <Button Classes="nav" Classes.active="{Binding IsActive}" Command="{Binding Go}" ToolTip.Tip="{Binding Title}" ToolTip.Placement="Right">
                              <StackPanel Orientation="Horizontal" Spacing="11">
                                <PathIcon Data="{Binding Icon}" Width="17" Height="17" />
                                <TextBlock Classes="wide" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </Button>
                            <Border Classes="navmark" Classes.on="{Binding IsActive}" />
                            <!-- a coroa marca as telas cuja ação principal é do Premium -->
                            <Panel Classes="wide" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                              <PathIcon Data="{StaticResource IcCrown}" Width="12" Height="12" Foreground="#A6FBC501" Margin="0,0,12,0" IsVisible="{Binding Locked}" />
                            </Panel>
                          </Panel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- conteúdo -->
      <Grid Grid.Column="1" RowDefinitions="40,*">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" IsVisible="{Binding Loading}">
          <c:UsageRing Width="14" Height="14" Thickness="2.5" Indeterminate="True" />
          <TextBlock Text="{Binding LoadingText}" FontSize="12" Foreground="{StaticResource Apagado}" />
        </StackPanel>
        <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}" Margin="30,0,30,26" />
      </Grid>
    </Grid>

    <!-- diálogo -->
    <Panel IsVisible="{Binding Dialog, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Background="#C4050403" />
      <ContentControl Content="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" />
    </Panel>

    <!-- operação em andamento -->
    <Panel IsVisible="{Binding Operation, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Background="#D2050403" />
      <ContentControl Content="{Binding Operation}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" />
    </Panel>

    <!-- aviso rápido -->
    <Border IsVisible="{Binding Toast, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
            Background="#F21E1D22" BorderBrush="#55FBC501" BorderThickness="1" CornerRadius="14" Padding="18,11">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <PathIcon Data="{StaticResource IcInfo}" Classes="small gold" />
        <TextBlock Text="{Binding Toast}" FontWeight="SemiBold" FontSize="13" />
      </StackPanel>
    </Border>
  </Panel>
</Window>
