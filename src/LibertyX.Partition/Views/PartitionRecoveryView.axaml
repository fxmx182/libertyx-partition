<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LibertyX.Partition.ViewModels"
             xmlns:c="using:LibertyX.Partition.Controls"
             x:Class="LibertyX.Partition.Views.PartitionRecoveryView"
             x:DataType="vm:PartitionRecoveryViewModel">
  <Panel>
    <DockPanel IsVisible="{Binding IsChoosing}">
      <StackPanel DockPanel.Dock="Top" Margin="0,4,0,18">
        <TextBlock Classes="h1" Text="Recuperar partição" />
        <TextBlock Classes="muted" Text="Partição excluída, disco que aparece como “não inicializado” ou “não alocado”, tabela corrompida." />
      </StackPanel>
      <Grid ColumnDefinitions="*,24,370">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <TextBlock Classes="section" Text="EM QUAL DISCO" />
            <ContentControl Content="{Binding Picker}" />
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
          <StackPanel Spacing="12">
            <TextBlock Classes="section" Text="COMO PROCURAR" />
            <Border Classes="option">
              <StackPanel Spacing="3">
                <RadioButton GroupName="modo" IsChecked="{Binding !Deep}" Content="Busca rápida" FontWeight="Bold" />
                <TextBlock Classes="faint" TextWrapping="Wrap" Margin="30,0,0,0" Text="Segue a corrente de volumes a partir do início do disco, nos limites de 1 MB e de cilindro. Acha quase tudo em segundos." />
              </StackPanel>
            </Border>
            <Border Classes="option">
              <StackPanel Spacing="3">
                <RadioButton GroupName="modo" IsChecked="{Binding Deep}" Content="Busca completa" FontWeight="Bold" />
                <TextBlock Classes="faint" TextWrapping="Wrap" Margin="30,0,0,0" Text="Lê o disco inteiro procurando setores de boot de NTFS, FAT, exFAT, ext e BitLocker — inclusive as cópias de reserva. Use quando a rápida não achar." />
              </StackPanel>
            </Border>
            <Border Classes="notice gold">
              <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Text="Nada é gravado durante a busca. Depois você escolhe: só copiar os arquivos para fora, ou devolver as partições à tabela." />
            </Border>
            <Button Classes="primary" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16,13" FontSize="15">
              <StackPanel Orientation="Horizontal" Spacing="9"><PathIcon Data="{StaticResource IcSearch}" /><TextBlock Text="Procurar partições" /></StackPanel>
            </Button>
            <Button Classes="ghost" Command="{Binding RestoreBackupCommand}" HorizontalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcRestore}" Classes="small" /><TextBlock Text="Restaurar um backup de tabela (.lxbak)…" /></StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </DockPanel>

    <StackPanel IsVisible="{Binding IsScanning}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
      <Panel Width="230" Height="230">
        <c:UsageRing Value="{Binding Fraction}" Thickness="14" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="{Binding FoundCount}" Classes="big" HorizontalAlignment="Center" Foreground="{StaticResource Ouro}" />
          <TextBlock Text="volumes achados" Classes="muted" HorizontalAlignment="Center" />
        </StackPanel>
      </Panel>
      <TextBlock Text="{Binding Phase}" Classes="h3" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding Elapsed}" Classes="faint" HorizontalAlignment="Center" />
      <Button Content="Cancelar" Command="{Binding StopCommand}" HorizontalAlignment="Center" />
    </StackPanel>

    <DockPanel IsVisible="{Binding IsResults}">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,4,0,16">
        <StackPanel>
          <TextBlock Classes="h1" Text="{Binding ResultText}" />
          <TextBlock Classes="muted" Text="Marque as que quer de volta. “Explorar” abre os arquivos sem gravar nada no disco." />
        </StackPanel>
        <Button Grid.Column="1" Content="Nova busca" Command="{Binding BackCommand}" VerticalAlignment="Center" />
      </Grid>
      <Border DockPanel.Dock="Bottom" Classes="glass" Padding="18,14" Margin="0,14,0,0">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="COMO O DISCO VAI FICAR" />
          <c:PartitionRibbon Items="{Binding Preview}" />
          <Grid ColumnDefinitions="Auto,*,Auto">
            <ComboBox SelectedIndex="{Binding StyleIndex}" Width="230">
              <ComboBoxItem>Tabela GPT</ComboBoxItem>
              <ComboBoxItem>Tabela MBR</ComboBoxItem>
            </ComboBox>
            <TextBlock Grid.Column="1" Text="{Binding RestoreBlock}" Foreground="{StaticResource Laranja}" VerticalAlignment="Center" Margin="14,0" TextWrapping="Wrap" FontSize="12.5" />
            <Button Grid.Column="2" Classes="primary" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}" Padding="18,11">
              <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcRestore}" /><TextBlock Text="Restaurar marcadas" /></StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Found}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FoundRow">
              <Border Classes="card" Padding="16,14">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                  <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Width="12" Height="40" CornerRadius="6" Background="{Binding ColorBrush}" Margin="4,0,14,0" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding LabelText}" FontWeight="ExtraBold" FontSize="15" />
                      <TextBlock Text="{Binding FsText}" Foreground="{StaticResource Apagado}" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                      <TextBlock Text="{Binding SizeText}" Foreground="{StaticResource Apagado}" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock FontSize="12" Foreground="{StaticResource Tenue}" Margin="0,3,0,0">
                      <Run Text="{Binding RangeText}" /><Run Text=" · achada pelo " /><Run Text="{Binding Evidence}" />
                    </TextBlock>
                  </StackPanel>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border Classes="chip" IsVisible="{Binding InTable}"><TextBlock Text="Já está na tabela" /></Border>
                    <Border Classes="chip gold" IsVisible="{Binding Confirmed}" ToolTip.Tip="A cópia de reserva do setor de boot confere"><TextBlock Text="Cópia confere" /></Border>
                    <Border Classes="chip orange" IsVisible="{Binding Conflicting}" ToolTip.Tip="Sobrepõe outra candidata mais confiável. Costuma ser o resto de um volume que foi movido ou recriado."><TextBlock Text="Sobreposta" /></Border>
                    <Border Classes="chip green" IsVisible="{Binding Verified}"><TextBlock Text="Estrutura íntegra" /></Border>
                    <Border Classes="chip orange" IsVisible="{Binding NotVerified}"><TextBlock Text="Estrutura danificada" /></Border>
                  </StackPanel>
                  <Button Grid.Column="4" Command="{Binding Explore}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcExplore}" Classes="small" /><TextBlock Text="Explorar" /></StackPanel>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Panel>
</UserControl>
