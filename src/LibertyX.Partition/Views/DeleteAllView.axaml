<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:l="using:LibertyX.Partition" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LibertyX.Partition.ViewModels" xmlns:c="using:LibertyX.Partition.Controls" xmlns:core="using:LibertyX.Partition.Core.Platform" x:Class="LibertyX.Partition.Views.DeleteAllView" x:DataType="vm:DeleteAllViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,18">
      <TextBlock Classes="h1" Text="{l:T 'Excluir todas as partições'}" />
      <TextBlock Classes="muted" Text="{l:T 'Deixa o disco vazio, pronto para reparticionar. Rápido: só a tabela muda.'}" />
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320" /><ColumnDefinition Width="20" /><ColumnDefinition Width="0.8*" MinWidth="270" MaxWidth="420" /></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10"><TextBlock Classes="section" Text="{l:T 'DISCO'}" /><ContentControl Content="{Binding Picker}" /></StackPanel>
      </ScrollViewer>
      <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="{l:T 'SAEM DA TABELA'}" />
          <ItemsControl ItemsSource="{Binding Parts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PartitionVM">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4" IsVisible="{Binding !IsUnallocated}">
                  <Border Width="10" Height="10" CornerRadius="5" Background="{Binding ColorBrush}" Margin="0,0,10,0" />
                  <TextBlock Grid.Column="1" FontWeight="SemiBold"><Run Text="{Binding Title}" /><Run Text="  " /><Run Text="{Binding FsText}" Foreground="{StaticResource Apagado}" /></TextBlock>
                  <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{StaticResource Apagado}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="notice gold"><TextBlock TextWrapping="Wrap" FontSize="12.5" Text="{l:T 'Os dados não são apagados agora — só ficam sem partição. Até serem sobrescritos, Recuperar partição devolve tudo. Um backup da tabela também é salvo.'}" /></Border>
          <Button Classes="danger" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="9"><PathIcon Data="{StaticResource IcDeleteAll}" /><TextBlock Text="{l:T 'Excluir todas'}" /></StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
